{
  "expo": {
    "name": "Stilllight",
    "slug": "stilllight",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/stilllight-icon.png",
    "scheme": "stilllight",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.stilllight.beta",
      "supportsTablet": true,
      "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EA",
        "foregroundImage": "./assets/images/stilllight-icon.png"
      },
      "package": "com.stilllight.beta",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/stilllight-favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "Choose a photo to edit in Stilllight.", "cameraPermission": "Take a photo to edit in Stilllight.", "microphonePermission": false }],
      ["expo-media-library", { "photosPermission": "Choose and save your Stilllight photos.", "savePhotosPermission": "Save your edited photo to your library.", "granularPermissions": ["photo"], "isAccessMediaLocationEnabled": false }],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5EF",
          "image": "./assets/images/stilllight-icon.png",
          "imageWidth": 100,
          "dark": { "backgroundColor": "#191A17", "image": "./assets/images/stilllight-icon.png" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
