# This server never selects a paid provider just because a key exists.
AI_MODE=demo
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/stilllight.sqlite
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Live AI is invite-only. Set AI_MODE=gemini only after approving API spend.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PILOT_INVITE_CODE=

# Global attempt cap includes failed and cancelled requests; not a dollar cap.
# Also configure a billing budget/quota with your AI provider.
MAX_DAILY_GENERATIONS=30
INITIAL_LIVE_CREDITS=3
SESSION_DAYS=30
RESULT_TTL_MINUTES=10
